{
  "name": "salesforce-demo-studio",
  "version": "0.1.0",
  "description": "Records whole Salesforce demos: your slides, a voice-over read by a local Piper voice, and live actions in Lightning, Setup, Experience Cloud, Agentforce chats, a terminal, VS Code or Cursor, assembled into one video. Also records Agentforce conversations on their own. No AI needed at record time.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "sfdemo": "bin/sfdemo.js",
    "afrec": "bin/sfdemo.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "packs",
    "schema",
    "examples",
    "skills",
    "docs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "denylist": "node scripts/check-denylist.js",
    "utam-diff": "node scripts/utam-diff.js"
  },
  "keywords": [
    "salesforce",
    "agentforce",
    "playwright",
    "recording",
    "demo",
    "embedded-messaging",
    "vscode",
    "terminal"
  ],
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "playwright": "1.63.0",
    "yaml": "2.9.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
